# Ignore node_modules (Hardhat dependencies - ~600 packages)
node_modules/

# Ignore Hardhat compilation artifacts (regenerated by `npx hardhat compile`)
artifacts/
cache/

# Ignore deployed address file (generated by deploy.js at runtime)
deployed_address.json

# Python bytecode
__pycache__/
*.pyc

# OS files
.DS_Store

# Personal notes (not for GitHub)
.notes/
